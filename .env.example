# Project ki root folder mein (docker-compose.yml ke saath) ye file ".env" naam se banayein.
# Kam az kam JWT_SECRET zaroori hai. Lamba random text rakhein, kisi ko na batayein.
JWT_SECRET=badal-dein-bohat-lamba-random-text

# Admin account ki email (Support Inbox ke liye), comma se alag karke kai bhi de sakte hain
ADMIN_EMAILS=admin@example.com

# Optional: password reset ka asli email bhejne ke liye (Gmail ka App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Fitness Tracker <email@gmail.com>"
JWT_SECRET=fitnesstracker_super_secret_key_2024
ADMIN_EMAILS=kanwal25@gmail.com